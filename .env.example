TELEGRAM_BOT_TOKEN=123456789:replace_me
ANTHROPIC_API_KEY=sk-fp-replace_me

# Direct Anthropic: claude-sonnet-5, claude-opus-5, claude-opus-4-6, claude-opus-4-8,
# claude-fable-5. Tokenator additionally: gpt-5.6-sol, gpt-5.6-terra, gemini-3.5-flash
ANTHROPIC_MODEL=gpt-5.6-sol
# low, medium, high, xhigh, max (xhigh is not supported by claude-opus-4-6).
# The main pass runs the whole specification; the fragment scan answers one question.
ANTHROPIC_EFFORT=high
ANTHROPIC_SCOUT_EFFORT=low
# The beat inventory, the reverse scan and the consistency check need somewhere to run.
# Turning this off makes the analysis noticeably shallower.
ANTHROPIC_THINKING_ENABLED=true
# Reasoning is billed as output, so the visible report needs headroom on top of it.
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_SCOUT_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=300
# Caches the constant prompt prefix on the direct Anthropic API. Ignored by Tokenator.
PROMPT_CACHE_ENABLED=true
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_DIR=.cache/miocard

# Usually leave empty: direct Anthropic and Tokenator endpoints are selected
# automatically from the key format (sk-ant-... or sk-fp-...).
ANTHROPIC_API_URL=

# Comma-separated Telegram numeric IDs. Moderators always have access, can select
# the global model and receive the analysis audit journal.
MODERATOR_USER_IDS=153241307
# true: send moderators the original ECG, user context and bot answer.
# false: keep only user, time, model, status and usage metadata (recommended for production).
ADMIN_AUDIT_INCLUDE_CONTENT=true
# Regular users allowed to use the service. Empty keeps access open to everyone.
ALLOWED_USER_IDS=
MAX_IMAGE_BYTES=20971520
MAX_CONCURRENT_ANALYSES=1
USER_COOLDOWN_SECONDS=10
