TELEGRAM_BOT_TOKEN=123456789:replace_me
ANTHROPIC_API_KEY=sk-fp-replace_me

# Direct Anthropic: claude-sonnet-5, claude-opus-4-6, claude-opus-4-8, claude-fable-5
# Tokenator additionally: gpt-5.6-sol, gpt-5.6-terra, gemini-3.5-flash
ANTHROPIC_MODEL=gpt-5.6-sol
# low, medium, high, max (xhigh is supported only by Sonnet 5)
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=3584
# Caches the constant prompt prefix on the direct Anthropic API. Ignored by Tokenator.
PROMPT_CACHE_ENABLED=true
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_DIR=.cache/miocard

# Usually leave empty: direct Anthropic and Tokenator endpoints are selected
# automatically from the key format (sk-ant-... or sk-fp-...).
ANTHROPIC_API_URL=

# Comma-separated Telegram numeric IDs. Moderators always have access, can select
# the global model and receive API usage notifications.
MODERATOR_USER_IDS=153241307
# Regular users allowed to use the service. Empty keeps access open to everyone.
ALLOWED_USER_IDS=
MAX_IMAGE_BYTES=20971520
MAX_CONCURRENT_ANALYSES=1
USER_COOLDOWN_SECONDS=10
